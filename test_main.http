# 2. 更新 @ auth_token 变量为实际令牌
# 3. 不要在生产环境使用硬编码令牌
# 4. 姓名测评接口可能需要较长时间，已优化超时设置到300秒，重试次数增加到5次

### ===========================================
### 1. 基础功能测试
### ===========================================

# 健康检查
GET {{base_url}}/

# Hello World测试
GET {{base_url}}/hello/TestUser

### ===========================================
### 2. 用户认证
### ===========================================

# 获取邮箱验证码
GET {{base_url}}/api/v1/auth/code?email=1726729576@qq.com

###
# 用户注册
POST {{base_url}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "1726729576@qq.com",
  "username": "测试用户",
  "password": "TestPass123",
  "confirm_password": "TestPass123",
  "code": "2705"
}

###
# 用户登录
POST {{base_url}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "1726729576@qq.com",
  "password": "09081002chen"
}

###
# 用户登出
POST {{base_url}}/api/v1/auth/logout
Authorization: {{auth_token}}

### ===========================================
### 3. 姓名生成与测评
### ===========================================

# 生成姓名（智能负载均衡）
POST {{base_url}}/api/v1/name
Authorization: {{auth_token}}
Content-Type: application/json

{
  "surname": "张",
  "gender": "女",
  "length": "两字",
  "other": "要大气优雅",
  "exclude": ["王", "李"]
}

###
# 生成姓名（DeepSeek）
POST {{base_url}}/api/v1/name/text
Authorization: {{auth_token}}
Content-Type: application/json

{
  "surname": "李",
  "gender": "男",
  "length": "不限",
  "other": "要有文化底蕴"
}

###
# 姓名测评
POST {{base_url}}/api/v1/name/evaluate
Authorization: {{auth_token}}
Content-Type: application/json

{
  "full_name": "张婉清",
  "gender": "女",
  "birthdate": "2000-01-01"
}

### ===========================================
### 4. 企业起名
### ===========================================

# 生成企业名称
POST {{base_url}}/api/v1/name/company
Authorization: {{auth_token}}
Content-Type: application/json

{
  "industry": "科技",
  "company_type": "有限责任公司",
  "business_scope": "软件开发和技术服务",
  "positioning": "创新型科技企业",
  "length": "4字",
  "style": "现代简约",
  "exclude": ["测试", "临时"]
}

###
# 查询企业起名历史
GET {{base_url}}/api/v1/name/company/history?page=1&page_size=10
Authorization: {{auth_token}}

### ===========================================
### 5. 产品起名
### ===========================================

# 生成产品名称
POST {{base_url}}/api/v1/name/product
Authorization: {{auth_token}}
Content-Type: application/json

{
  "product_type": "智能手机",
  "product_function": "高端智能手机，注重拍照和性能",
  "target_audience": "年轻人",
  "market_positioning": "高端旗舰",
  "length": "2字",
  "style": "现代时尚"
}

###
# 查询产品起名历史
GET {{base_url}}/api/v1/name/product/history?page=1&page_size=10
Authorization: {{auth_token}}


### ===========================================
### 6. 数据查询与统计
### ===========================================

# 查询生成历史
GET {{base_url}}/api/v1/name/history?page=1&page_size=10
Authorization: {{auth_token}}

###
# 统一删除历史记录（支持公司/产品/姓名）
# 删除单个历史记录
DELETE {{base_url}}/api/v1/name/history/unified
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 2,
  "history_type": "company"
}

###
# 批量删除指定类型历史记录
DELETE {{base_url}}/api/v1/name/history/batch
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_ids": [1, 2, 3],
  "history_type": "company"
}

###
# 查询名字重复率
GET {{base_url}}/api/v1/name/repetition?name=张伟&gender=男
Authorization: {{auth_token}}

###
# 查询热门名字
GET {{base_url}}/api/v1/name/top?gender=男&limit=10
Authorization: {{auth_token}}

###
# 查询所有历史（统一接口）
GET {{base_url}}/api/v1/name/history/all?page=1&page_size=5&history_type=name
Authorization: {{auth_token}}

### ===========================================
### 7. 收藏管理
### ===========================================

# ---------- 通用收藏（孩子起名） ----------

# 添加收藏（孩子起名）
POST {{base_url}}/api/v1/favorite/add
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 35
}

###
# 移除收藏（孩子起名）
POST {{base_url}}/api/v1/favorite/remove
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 35
}

###
# 获取收藏列表（所有类型）
GET {{base_url}}/api/v1/favorite/list?page=1&page_size=10
Authorization: {{auth_token}}

# ---------- 企业起名收藏 ----------
# 注意: 统一使用孩子收藏API处理所有收藏类型！
# 企业起名收藏也使用 /api/v1/favorite/add

###
# 添加企业起名收藏 (使用统一的收藏API)
POST {{base_url}}/api/v1/favorite/add
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 4
}

###
# 移除企业起名收藏 (使用统一的收藏API)
POST {{base_url}}/api/v1/favorite/remove
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 4
}

###
# 获取企业起名收藏列表
GET {{base_url}}/api/v1/name/company/favorite/list?page=1&page_size=10
Authorization: {{auth_token}}

# ---------- 产品起名收藏 ----------
# 注意: 统一使用孩子收藏API处理所有收藏类型！
# 产品起名收藏也使用 /api/v1/favorite/add

###
# 添加产品起名收藏 (使用统一的收藏API)
POST {{base_url}}/api/v1/favorite/add
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 3
}

###
# 移除产品起名收藏 (使用统一的收藏API)
POST {{base_url}}/api/v1/favorite/remove
Authorization: {{auth_token}}
Content-Type: application/json

{
  "history_id": 3
}

###
# 获取产品起名收藏列表
GET {{base_url}}/api/v1/name/product/favorite/list?page=1&page_size=10
Authorization: {{auth_token}}

### ===========================================
### 8. 用户管理
### ===========================================

# 获取用户信息
GET {{base_url}}/api/v1/user/profile
Authorization: {{auth_token}}

###
# 更新用户信息
PUT {{base_url}}/api/v1/user/profile
Authorization: {{auth_token}}
Content-Type: application/json

{
  "nickname": "清风明月",
  "gender": "男",
  "phone": "13900139000"
}

###
# 修改密码
PUT {{base_url}}/api/v1/user/change-password
Authorization: {{auth_token}}
Content-Type: application/json

{
  "old_password": "TestPass123",
  "new_password": "NewPass456",
  "confirm_new_password": "NewPass456"
}

###
# 上传头像
POST {{base_url}}/api/v1/user/avatar
Authorization: {{auth_token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./app/static/avatar_test.png
------WebKitFormBoundary--

###
# 用户注销
POST {{base_url}}/api/v1/user/deleteuser
Authorization: {{auth_token}}

### ===========================================
### 9. 系统监控
### ===========================================

# AI服务状态监控
GET {{base_url}}/api/v1/name/ai/status

###
# 邮件测试
GET {{base_url}}/mail/test?email=test@example.com

### ===========================================
### 使用说明
### 1. 按顺序执行：先注册→登录→获取令牌→测试其他接口
### 2. 更新 @auth_token 变量为实际的JWT令牌
### 3. 测试数据可根据需要修改
### 4. 统一删除接口支持 company/product/name 三种类型
### 5. 批量删除支持按类型过滤
### 6. 姓名测评接口需要较长时间，运行时请使用 --timeout=120 参数
### 7. 收藏功能支持三种类型：孩子起名、企业起名、产品起名
### 8. 统一使用孩子收藏API处理所有收藏类型
### 9. 所有收藏都使用: POST /api/v1/favorite/add
### 10. 所有移除都使用: POST /api/v1/favorite/remove
### 11. 所有列表都使用: GET /api/v1/favorite/list
### 12. 统一的JSON格式: {"history_id": ID}
### 13. 生产环境请使用真实数据和安全令牌
### ===========================================
